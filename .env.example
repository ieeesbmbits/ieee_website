# ==============================================================================
# IEEE MBITS Website - Environment Variables Configuration
# Copy this file to .env and fill in your secrets. NEVER commit .env to Git!
# ==============================================================================

# --- Sender & Admin Addresses ---
SENDER_EMAIL=noreply@ieeembits.com
ADMIN_EMAILS=ieeesbmbits@mbits.ac.in,ieeesbmbits@gmail.com

# --- Option 1: Cloudflare Pages / Resend (Recommended Serverless Provider) ---
# Sign up at https://resend.com and add an API key
RESEND_API_KEY=re_your_resend_api_key_placeholder

# --- Option 2: EmailJS Configuration ---
# Configured in your EmailJS Dashboard (https://dashboard.emailjs.com/)
EMAILJS_SERVICE_ID=service_1z9s12v
EMAILJS_TEMPLATE_ID=template_gfb2p3a
EMAILJS_PUBLIC_KEY=0LbUjqGewEYtLvFkg
EMAILJS_PRIVATE_KEY=your_emailjs_private_key_placeholder

# --- Option 3: Python Local SMTP Server (api/send-email.py) ---
# Generate at: Google Account -> Security -> 2-Step Verification -> App Passwords
GMAIL_APP_PASSWORD=your_16_digit_app_password_placeholder
APP_PASSWORD=your_16_digit_app_password_placeholder
PORT=5000
